timestamp=2026-09-07T02:22:03.531Z level=INFO run=ac30bf05 message=evaluated permission=bash pattern="python3 -c '\nimport math\n\ndef get_butter_ba(order, cutoff, fs):\n    # Prewarped frequency\n    w = 2.0 * math.tan(math.pi * cutoff / fs)\n    # Poles of analog Butterworth filter\n    poles = []\n    for k in range(order):\n        angle = math.pi * (2 * k + 1 + order) / (2 * order)\n        sk = complex(w * math.cos(angle), w * math.sin(angle))\n        # Bilinear transform: zk = (2 + sk) / (2 - sk)\n        zk = (2.0 + sk) / (2.0 - sk)\n        poles.append(zk)\n    \n    # Polynomial from roots\n    # P(z) = prod(z - zk) = z^N - ...\n    # We want A(z) = prod(1 - zk * z^-1) = sum a_k z^-k\n    # where a_0 = 1\n    a = [1.0]\n    for p in poles:\n        # multiply by (1 - p * z^-1)\n        new_a = [0.0] * (len(a) + 1)\n        for i, val in enumerate(a):\n            new_a[i] += val\n            new_a[i + 1] -= val * p\n        a = new_a\n    \n    a_real = [val.real for val in a]\n    \n    # Numerator B(z) = K * (1 + z^-1)^order\n    # Binomial coefficients for (1 + x)^order\n    b_binom = []\n    for k in range(order + 1):\n        b_binom.append(math.comb(order, k))\n    \n    # DC gain is 1, so sum(b) / sum(a) = 1\n    sum_a = sum(a_real)\n    sum_b_binom = sum(b_binom) # 2^order\n    scale = sum_a / sum_b_binom\n    b_real = [c * scale for c in b_binom]\n    \n    return b_real, a_real\n\nb, a = get_butter_ba(4, 20.0, 200.0)\nprint(\"b:\", b)\nprint(\"a:\", a)\n'" action.permission=* action.action=allow action.pattern=*
