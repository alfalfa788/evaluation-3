timestamp=2026-09-07T02:22:07.186Z level=INFO run=ac30bf05 message=evaluated permission=bash pattern="python3 -c '\nimport math\n\ndef get_butter_ba(order, cutoff, fs):\n    w = 2.0 * math.tan(math.pi * cutoff / fs)\n    poles = []\n    for k in range(order):\n        angle = math.pi * (2 * k + 1 + order) / (2 * order)\n        sk = complex(w * math.cos(angle), w * math.sin(angle))\n        zk = (2.0 + sk) / (2.0 - sk)\n        poles.append(zk)\n    \n    a = [1.0]\n    for p in poles:\n        new_a = [0.0] * (len(a) + 1)\n        for i, val in enumerate(a):\n            new_a[i] += val\n            new_a[i + 1] -= val * p\n        a = new_a\n    \n    a_real = [val.real for val in a]\n    b_binom = [math.comb(order, k) for k in range(order + 1)]\n    sum_a = sum(a_real)\n    sum_b_binom = sum(b_binom)\n    scale = sum_a / sum_b_binom\n    b_real = [c * scale for c in b_binom]\n    return b_real, a_real\n\ndef lfilter(b, a, x):\n    y = [0.0] * len(x)\n    for n in range(len(x)):\n        val = 0.0\n        for i in range(len(b)):\n            if n - i >= 0:\n                val += b[i] * x[n - i]\n        for j in range(1, len(a)):\n            if n - j >= 0:\n                val -= a[j] * y[n - j]\n        y[n] = val / a[0]\n    return y\n\ndef filtfilt(b, a, x):\n    y_fwd = lfilter(b, a, x)\n    y_rev = lfilter(b, a, y_fwd[::-1])\n    return y_rev[::-1]\n\nb, a = get_butter_ba(4, 20.0, 200.0)\ntest_sig = [math.sin(2 * math.pi * 5 * i / 200.0) + math.sin(2 * math.pi * 50 * i / 200.0) for i in range(200)]\nfiltered = filtfilt(b, a, test_sig)\nprint(\"Initial 5 raw vs filtered:\", list(zip(test_sig[:5], filtered[:5])))\n'" action.permission=* action.action=allow action.pattern=*
