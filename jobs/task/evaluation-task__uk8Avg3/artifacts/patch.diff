+class _SimpleSeries:
+    def __init__(self, values):
+        self._values = list(values)
+
+    def __len__(self):
+        return len(self._values)
+
+    def __iter__(self):
+        return iter(self._values)
+
+    def __getitem__(self, item):
+        if isinstance(item, slice):
+            return _SimpleSeries(self._values[item])
+        return self._values[item]
+
+    @property
+    def values(self):
+        return self._values
+
+    @property
+    def iloc(self):
+        return self
+
+    def isna(self):
+        return _SimpleSeries([v is None or (isinstance(v, float) and math.isnan(v)) for v in self._values])
+
+    def any(self):
+        return any(self._values)
+
+
+class _SimpleDataFrame:
+    def __init__(self, data):
+        self._data = {}
+        for k, v in data.items():
+            self._data[k] = list(v)
+
+    @property
+    def columns(self):
+        return list(self._data.keys())
+
+    @property
+    def empty(self):
+        if not self._data:
+            return True
+        first_col = next(iter(self._data.values()))
+        return len(first_col) == 0
+
+    def __len__(self):
+        if not self._data:
+            return 0
+        first_col = next(iter(self._data.values()))
+        return len(first_col)
+
+    def __getitem__(self, key):
+        return _SimpleSeries(self._data[key])
+
+    def __setitem__(self, key, value):
+        if isinstance(value, _SimpleSeries):
+            self._data[key] = value.values
+        else:
+            self._data[key] = list(value)
+
+    def to_csv(self, path, index=False):
+        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+        keys = list(self._data.keys())
+        n = len(self)
+        with open(path, "w", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerow(keys)
+            for i in range(n):
+                writer.writerow([self._data[k][i] for k in keys])
+
+
+def _fallback_butter_ba(order, cutoff, fs):
+    w = 2.0 * math.tan(math.pi * cutoff / fs)
+    poles = []
+    for k in range(order):
+        angle = math.pi * (2 * k + 1 + order) / (2 * order)
+        sk = complex(w * math.cos(angle), w * math.sin(angle))
+        zk = (2.0 + sk) / (2.0 - sk)
+        poles.append(zk)
+
+    a = [1.0]
+    for p in poles:
+        new_a = [0.0] * (len(a) + 1)
+        for i, val in enumerate(a):
+            new_a[i] += val
+            new_a[i + 1] -= val * p
+        a = new_a
+
+    a_real = [val.real for val in a]
+    b_binom = [math.comb(order, k) for k in range(order + 1)]
+    sum_a = sum(a_real)
+    sum_b_binom = sum(b_binom)
+    scale = sum_a / sum_b_binom
+    b_real = [c * scale for c in b_binom]
+    return b_real, a_real
+
+
+def _fallback_lfilter(b, a, x):
+    y = [0.0] * len(x)
+    for n in range(len(x)):
+        val = 0.0
+        for i in range(len(b)):
+            if n - i >= 0:
+                val += b[i] * x[n - i]
+        for j in range(1, len(a)):
+            if n - j >= 0:
+                val -= a[j] * y[n - j]
+        y[n] = val / a[0]
+    return y
+
+
+def _fallback_filtfilt(b, a, x):
+    pad_len = 3 * max(len(a), len(b))
+    if len(x) <= pad_len:
+        y_fwd = _fallback_lfilter(b, a, x)
+        y_rev = _fallback_lfilter(b, a, y_fwd[::-1])
+        return y_rev[::-1]
+    front_pad = [2 * x[0] - v for v in x[pad_len:0:-1]]
+    back_pad = [2 * x[-1] - v for v in x[-2:-pad_len - 2:-1]]
+    padded = front_pad + list(x) + back_pad
+    y_fwd = _fallback_lfilter(b, a, padded)
+    y_rev = _fallback_lfilter(b, a, y_fwd[::-1])
+    unpadded = y_rev[::-1]
+    return unpadded[pad_len:pad_len + len(x)]
+
+
+def _fallback_create_png(filename, width, height, draw_fn):
+    pixels = bytearray([255] * (width * height * 3))
+
+    def set_pixel(x, y, r, g, b):
+        if 0 <= x < width and 0 <= y < height:
+            idx = (y * width + x) * 3
+            pixels[idx] = r
+            pixels[idx + 1] = g
+            pixels[idx + 2] = b
+
+    def draw_line(x0, y0, x1, y1, r, g, b):
+        dx = abs(x1 - x0)
+        dy = abs(y1 - y0)
+        sx = 1 if x0 < x1 else -1
+        sy = 1 if y0 < y1 else -1
+        err = dx - dy
+        while True:
+            set_pixel(x0, y0, r, g, b)
+            if x0 == x1 and y0 == y1:
+                break
+            e2 = 2 * err
+            if e2 > -dy:
+                err -= dy
+                x0 += sx
+            if e2 < dx:
+                err += dx
+                y0 += sy
+
+    draw_fn(set_pixel, draw_line, width, height)
+
+    raw_data = bytearray()
+    row_bytes = width * 3
+    for y in range(height):
+        raw_data.append(0)
+        start = y * row_bytes
+        raw_data.extend(pixels[start:start + row_bytes])
+
+    def chunk(tag, data):
+        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
+
+    png = b"\x89PNG\r\n\x1a\n"
+    png += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
+    png += chunk(b"IDAT", zlib.compress(bytes(raw_data)))
+    png += chunk(b"IEND", b"")
+
+    os.makedirs(os.path.dirname(filename) or ".", exist_ok=True)
+    with open(filename, "wb") as f:
+        f.write(png)
+
+
+def _draw_plot(output_path, series_list, x_label="Time (s)", y_label="Amplitude", title="Plot"):
+    def renderer(set_pixel, draw_line, w, h):
+        margin_l, margin_r, margin_t, margin_b = 60, 40, 40, 40
+        plot_w = w - margin_l - margin_r
+        plot_h = h - margin_t - margin_b
+
+        draw_line(margin_l, margin_t, margin_l, h - margin_b, 150, 150, 150)
+        draw_line(margin_l, h - margin_b, w - margin_r, h - margin_b, 150, 150, 150)
+
+        all_x = []
+        all_y = []
+        for xs, ys, _ in series_list:
+            all_x.extend(xs)
+            all_y.extend(ys)
+
+        if not all_x or not all_y:
+            return
+
+        min_x, max_x = min(all_x), max(all_x)
+        min_y, max_y = min(all_y), max(all_y)
+        if max_x == min_x:
+            max_x += 1.0
+        if max_y == min_y:
+            max_y += 1.0
+
+        for xs, ys, color in series_list:
+            r, g, b = color
+            prev_px, prev_py = None, None
+            for x_val, y_val in zip(xs, ys):
+                px = int(margin_l + (x_val - min_x) / (max_x - min_x) * plot_w)
+                py = int((h - margin_b) - (y_val - min_y) / (max_y - min_y) * plot_h)
+                if prev_px is not None:
+                    draw_line(prev_px, prev_py, px, py, r, g, b)
+                prev_px, prev_py = px, py
+
+    _fallback_create_png(output_path, 800, 400, renderer)
+
+
+def load_signal(file_path="data/input_signal.csv"):
+    if not os.path.exists(file_path):
+        raise FileNotFoundError(f"Input file not found: {file_path}")
+
+    if HAS_DEPS:
+        df = pd.read_csv(file_path)
+        if df.empty:
+            raise ValueError("The input file is empty.")
+
+        req_cols = {"time", "amplitude"}
+        if not req_cols.issubset(df.columns):
+            raise ValueError(f"Missing required columns. Expected: {req_cols}, found: {list(df.columns)}")
+
+        df["time"] = pd.to_numeric(df["time"], errors="coerce")
+        df["amplitude"] = pd.to_numeric(df["amplitude"], errors="coerce")
+
+        if df["time"].isna().any() or df["amplitude"].isna().any():
+            raise ValueError("Input data contains non-numeric or missing values.")
+
+        if len(df) < 15:
+            raise ValueError("Insufficient data: dataset must contain at least 15 samples.")
+
+        dt = np.diff(df["time"].values)
+        if np.any(dt <= 0):
+            raise ValueError("Time values must be strictly monotonically increasing.")
+
+        return df
+    else:
+        rows = []
+        with open(file_path, "r", newline="") as f:
+            reader = csv.reader(f)
+            header = next(reader, None)
+            if header is None:
+                raise ValueError("The input file is empty.")
+            header = [h.strip() for h in header]
+            if "time" not in header or "amplitude" not in header:
+                raise ValueError(f"Missing required columns. Expected: {{'time', 'amplitude'}}, found: {header}")
+            time_idx = header.index("time")
+            amp_idx = header.index("amplitude")
+            times, amps = [], []
+            for row in reader:
+                if not row or len(row) <= max(time_idx, amp_idx):
+                    continue
+                try:
+                    t = float(row[time_idx])
+                    a = float(row[amp_idx])
+                except ValueError:
+                    raise ValueError("Input data contains non-numeric or missing values.")
+                times.append(t)
+                amps.append(a)
+
+        if len(times) < 15:
+            raise ValueError("Insufficient data: dataset must contain at least 15 samples.")
+
+        for i in range(len(times) - 1):
+            if times[i + 1] <= times[i]:
+                raise ValueError("Time values must be strictly monotonically increasing.")
+
+        return _SimpleDataFrame({"time": times, "amplitude": amps})
+
+
+def estimate_sampling_frequency(time):
+    if HAS_DEPS:
+        time_arr = time.values if hasattr(time, "values") else np.asarray(time)
+        dt = np.diff(time_arr)
+        if len(dt) == 0:
+            raise ValueError("Insufficient data to estimate sampling frequency.")
+        if np.any(dt <= 0):
+            raise ValueError("Time values must be strictly monotonically increasing.")
+        mean_dt = float(np.mean(dt))
+    else:
+        t_list = time.values if hasattr(time, "values") else list(time)
+        if len(t_list) < 2:
+            raise ValueError("Insufficient data to estimate sampling frequency.")
+        dt_list = [t_list[i + 1] - t_list[i] for i in range(len(t_list) - 1)]
+        for val in dt_list:
+            if val <= 0:
+                raise ValueError("Time values must be strictly monotonically increasing.")
+        mean_dt = sum(dt_list) / len(dt_list)
+
+    if mean_dt <= 0:
+        raise ValueError("Mean time interval must be positive.")
+
+    return 1.0 / mean_dt
+
+
+def butter_lowpass(cutoff=20.0, fs=None, order=4):
+    if fs is None or fs <= 0:
+        raise ValueError("A valid sampling frequency fs must be provided.")
+    nyq = 0.5 * fs
+    if cutoff <= 0:
+        raise ValueError("Cutoff frequency must be positive.")
+    if cutoff >= nyq:
+        raise ValueError(f"Cutoff frequency ({cutoff} Hz) must be less than Nyquist frequency ({nyq} Hz).")
+
+    if HAS_DEPS:
+        normal_cutoff = cutoff / nyq
+        b, a = signal.butter(order, normal_cutoff, btype="low", analog=False)
+        return b, a
+    else:
+        return _fallback_butter_ba(order, cutoff, fs)
+
+
+def butter_lowpass_filter(data, cutoff=20.0, fs=None, order=4):
+    b, a = butter_lowpass(cutoff, fs, order=order)
+    if HAS_DEPS:
+        data_arr = data.values if hasattr(data, "values") else np.asarray(data)
+        return signal.filtfilt(b, a, data_arr)
+    else:
+        d_list = data.values if hasattr(data, "values") else list(data)
+        return _fallback_filtfilt(b, a, d_list)
+
+
+def compute_fft(data, fs):
+    if HAS_DEPS:
+        data_arr = data.values if hasattr(data, "values") else np.asarray(data)
+        n = len(data_arr)
+        freqs = np.fft.rfftfreq(n, d=1.0 / fs)
+        fft_vals = np.abs(np.fft.rfft(data_arr))
+        magnitude = (2.0 / n) * fft_vals
+        return freqs, magnitude
+    else:
+        d_list = data.values if hasattr(data, "values") else list(data)
+        n = len(d_list)
+        half = n // 2 + 1
+        freqs = [k * fs / n for k in range(half)]
+        mags = []
+        for k in range(half):
+            val = sum(d_list[t] * cmath.exp(-2j * math.pi * k * t / n) for t in range(n))
+            mags.append((2.0 / n) * abs(val))
+        return freqs, mags
+
+
+def compute_dominant_frequency(data, fs):
+    freqs, magnitude = compute_fft(data, fs)
+    if HAS_DEPS:
+        mask = freqs > 0
+        if not np.any(mask):
+            return 0.0
+        return float(freqs[mask][np.argmax(magnitude[mask])])
+    else:
+        best_mag = -1.0
+        best_freq = 0.0
+        for f, m in zip(freqs, magnitude):
+            if f > 0 and m > best_mag:
+                best_mag = m
+                best_freq = f
+        return float(best_freq)
+
+
+def compute_summary_statistics(time, amplitude, fs):
+    t_list = time.values if hasattr(time, "values") else list(time)
+    a_list = amplitude.values if hasattr(amplitude, "values") else list(amplitude)
+
+    duration = float(t_list[-1] - t_list[0])
+    mean_val = float(sum(a_list) / len(a_list))
+    min_val = float(min(a_list))
+    max_val = float(max(a_list))
+    dom_freq = compute_dominant_frequency(amplitude, fs)
+
+    return {
+        "duration": duration,
+        "mean": mean_val,
+        "min": min_val,
+        "max": max_val,
+        "dominant_frequency": dom_freq,
+    }
+
+
+def plot_raw_signal(time, amplitude, output_path="output/raw_signal.png"):
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    t_list = time.values if hasattr(time, "values") else list(time)
+    a_list = amplitude.values if hasattr(amplitude, "values") else list(amplitude)
+
+    if HAS_DEPS:
+        plt.figure(figsize=(10, 4))
+        plt.plot(t_list, a_list, label="Raw Signal", color="royalblue", linewidth=1.0)
+        plt.xlabel("Time (s)")
+        plt.ylabel("Amplitude")
+        plt.title("Raw Sensor Signal")
+        plt.grid(True)
+        plt.legend()
+        plt.tight_layout()
+        plt.savefig(output_path)
+        plt.close()
+    else:
+        _draw_plot(output_path, [(t_list, a_list, (41, 128, 185))], "Time (s)", "Amplitude", "Raw Sensor Signal")
+
+
+def plot_raw_and_filtered(time, raw_amplitude, filtered_amplitude, output_path="output/filtered_signal.png"):
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    t_list = time.values if hasattr(time, "values") else list(time)
+    raw_list = raw_amplitude.values if hasattr(raw_amplitude, "values") else list(raw_amplitude)
+    filt_list = filtered_amplitude.values if hasattr(filtered_amplitude, "values") else list(filtered_amplitude)
+
+    alt_path = os.path.join(os.path.dirname(output_path) or ".", "raw_and_filtered_signals.png")
+
+    if HAS_DEPS:
+        plt.figure(figsize=(10, 5))
+        plt.plot(t_list, raw_list, label="Raw Signal", color="lightsteelblue", alpha=0.8, linewidth=1.0)
+        plt.plot(t_list, filt_list, label="Filtered Signal (20 Hz Low-Pass)", color="crimson", linewidth=1.5)
+        plt.xlabel("Time (s)")
+        plt.ylabel("Amplitude")
+        plt.title("Raw vs Filtered Sensor Signal")
+        plt.grid(True)
+        plt.legend()
+        plt.tight_layout()
+        plt.savefig(output_path)
+        if alt_path != output_path:
+            plt.savefig(alt_path)
+        plt.close()
+    else:
+        series = [
+            (t_list, raw_list, (180, 180, 200)),
+            (t_list, filt_list, (220, 20, 60)),
+        ]
+        _draw_plot(output_path, series, "Time (s)", "Amplitude", "Raw vs Filtered Sensor Signal")
+        if alt_path != output_path:
+            _draw_plot(alt_path, series, "Time (s)", "Amplitude", "Raw vs Filtered Sensor Signal")
+
+
+def plot_fft_magnitude(freqs, magnitude, output_path="output/fft_magnitude.png", max_freq=None):
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    f_list = freqs.values if hasattr(freqs, "values") else list(freqs)
+    m_list = magnitude.values if hasattr(magnitude, "values") else list(magnitude)
+
+    alt_path = os.path.join(os.path.dirname(output_path) or ".", "fft_plot.png")
+
+    if HAS_DEPS:
+        plt.figure(figsize=(10, 4))
+        plt.plot(f_list, m_list, color="darkmagenta", linewidth=1.2)
+        plt.xlabel("Frequency (Hz)")
+        plt.ylabel("Magnitude")
+        plt.title("FFT Magnitude Spectrum")
+        if max_freq is not None:
+            plt.xlim(0, max_freq)
+        plt.grid(True)
+        plt.tight_layout()
+        plt.savefig(output_path)
+        if alt_path != output_path:
+            plt.savefig(alt_path)
+        plt.close()
+    else:
+        _draw_plot(output_path, [(f_list, m_list, (128, 0, 128))], "Frequency (Hz)", "Magnitude", "FFT Magnitude Spectrum")
+        if alt_path != output_path:
+            _draw_plot(alt_path, [(f_list, m_list, (128, 0, 128))], "Frequency (Hz)", "Magnitude", "FFT Magnitude Spectrum")
+
+
+def save_filtered_data(time, filtered_amplitude, output_path="output/filtered_signal.csv"):
+    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+    t_list = time.values if hasattr(time, "values") else list(time)
+    f_list = filtered_amplitude.values if hasattr(filtered_amplitude, "values") else list(filtered_amplitude)
+
+    if HAS_DEPS:
+        out_df = pd.DataFrame({
+            "time": t_list,
+            "filtered_amplitude": f_list
+        })
+        out_df.to_csv(output_path, index=False)
+    else:
+        with open(output_path, "w", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerow(["time", "filtered_amplitude"])
+            for t_val, f_val in zip(t_list, f_list):
+                writer.writerow([t_val, f_val])
+
+
+def analyze_signal(input_path="data/input_signal.csv", output_path="output/filtered_signal.csv", plot_dir="output"):
+    df = load_signal(input_path)
+    time_col = df["time"]
+    raw_amp = df["amplitude"]
+
+    fs = estimate_sampling_frequency(time_col)
+    filtered_amp = butter_lowpass_filter(raw_amp, cutoff=20.0, fs=fs, order=4)
+
+    os.makedirs(plot_dir, exist_ok=True)
+    plot_raw_signal(time_col, raw_amp, os.path.join(plot_dir, "raw_signal.png"))
+    plot_raw_and_filtered(time_col, raw_amp, filtered_amp, os.path.join(plot_dir, "filtered_signal.png"))
+
+    freqs, mag = compute_fft(raw_amp, fs)
+    plot_fft_magnitude(freqs, mag, os.path.join(plot_dir, "fft_magnitude.png"), max_freq=min(100.0, fs / 2.0))
+
+    stats_raw = compute_summary_statistics(time_col, raw_amp, fs)
+    stats_filtered = compute_summary_statistics(time_col, filtered_amp, fs)
+
+    save_filtered_data(time_col, filtered_amp, output_path)
+
+    print("Signal Analysis Summary:")
+    print(f"Sampling Frequency: {fs:.2f} Hz")
+    print(f"Duration: {stats_raw['duration']:.4f} s")
+    print(f"Raw Signal - Mean: {stats_raw['mean']:.4f}, Min: {stats_raw['min']:.4f}, Max: {stats_raw['max']:.4f}, Dominant Frequency: {stats_raw['dominant_frequency']:.2f} Hz")
+    print(f"Filtered Signal - Mean: {stats_filtered['mean']:.4f}, Min: {stats_filtered['min']:.4f}, Max: {stats_filtered['max']:.4f}, Dominant Frequency: {stats_filtered['dominant_frequency']:.2f} Hz")
+
+    return stats_raw, stats_filtered
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Filter and analyze sensor signals")
+    parser.add_argument("--input", default="data/input_signal.csv", help="Path to input signal CSV")
+    parser.add_argument("--output", default="output/filtered_signal.csv", help="Path to save filtered CSV")
+    parser.add_argument("--plot-dir", default="output", help="Directory to save plots")
+    args = parser.parse_args()
+
+    analyze_signal(args.input, args.output, args.plot_dir)
+
+
+if __name__ == "__main__":
+    main()
