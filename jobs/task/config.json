{
    "job_name": "task",
    "n_concurrent_trials": 2,
    "agents": [
        {
            "name": "opencode",
            "model_name": "google/selene",
            "kwargs": {
                "version": "1.18.18",
                "opencode_config": {
                    "provider": {
                        "google": {
                            "options": {
                                "baseURL": "https://app-llmproxy.dataannotation.tech/api/llm_proxy/gemini/v1beta"
                            }
                        }
                    }
                }
            },
            "env": {
                "GEMINI_API_BASE": "https://app-llmproxy.dataannotation.tech/api/llm_proxy/gemini/v1beta",
                "GOOGLE_BASE_URL": "https://app-llmproxy.dataannotation.tech/api/llm_proxy/gemini/v1beta",
                "GOOGLE_GENERATIVE_AI_API_KEY": "${GEMINI_API_KEY}",
                "OPENCODE_DISABLE_AUTOUPDATE": "true",
                "OPENCODE_DISABLE_TERMINAL_TITLE": "true"
            }
        },
        {
            "name": "opencode",
            "model_name": "google/keats",
            "kwargs": {
                "version": "1.18.18",
                "opencode_config": {
                    "provider": {
                        "google": {
                            "options": {
                                "baseURL": "https://app-llmproxy.dataannotation.tech/api/llm_proxy/gemini/v1beta"
                            }
                        }
                    }
                }
            },
            "env": {
                "GEMINI_API_BASE": "https://app-llmproxy.dataannotation.tech/api/llm_proxy/gemini/v1beta",
                "GOOGLE_BASE_URL": "https://app-llmproxy.dataannotation.tech/api/llm_proxy/gemini/v1beta",
                "GOOGLE_GENERATIVE_AI_API_KEY": "${GEMINI_API_KEY}",
                "OPENCODE_DISABLE_AUTOUPDATE": "true",
                "OPENCODE_DISABLE_TERMINAL_TITLE": "true"
            }
        }
    ],
    "tasks": [
        {
            "path": "evaluation-task"
        }
    ]
}